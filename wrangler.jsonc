{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "who-is-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AI_MODEL": "gpt-4o-mini",
    "APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
    "APPWRITE_PROJECT_ID": "6a6bf96d001d30e4ea36",
    // APPWRITE_API_KEY는 secret으로 별도 등록 (wrangler secret put)
    "APPWRITE_DATABASE_ID": "6a6c1ec1002652651e23",
    "APPWRITE_STATS_TABLE_ID": "game"
    ,"APPWRITE_NICKNAMES_TABLE_ID": "nicknames"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoomDO" },
      { "name": "LOBBY", "class_name": "LobbyRegistryDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoomDO", "LobbyRegistryDO"]
    }
  ]
}
