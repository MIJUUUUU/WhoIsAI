OPENAI_API_KEY=sk-your-key-here

# 선택: 라운드 길이 오버라이드 (ms). 로컬 테스트 시 짧게 줄이면 편합니다.
# DISCUSSION_MS=180000
# VOTING_MS=30000
# ROUND_RESULT_MS=6000
# MAX_ROUNDS=5

# Appwrite: Database + player_stats 테이블, API 키 (Settings > API Keys, databases 읽기/쓰기 스코프)
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_STATS_TABLE_ID=your-table-id
APPWRITE_API_KEY=your-appwrite-api-key
